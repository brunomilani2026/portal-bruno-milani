# Copie para .env.local (desenvolvimento) e cadastre os mesmos nomes na Vercel (produção).
# NUNCA coloque valores reais neste arquivo.

# Senha de acesso ao portal (mínimo 12 caracteres; use uma frase longa). Só você sabe.
PORTAL_PASSWORD=

# Segredo para assinar a sessão (mínimo 32 caracteres aleatórios).
PORTAL_SESSION_SECRET=

# Endereços dos seus sistemas (opcionais). Finanças e Partitura já têm endereço padrão em src/apps.ts;
# preencha só se quiser sobrescrever. Briefing e CRM ficam "Em breve" até existirem.
URL_FINANCAS=
URL_PARTITURA_CAVACO=
URL_BRIEFING=
URL_CRM=
